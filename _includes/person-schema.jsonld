{
  "@context": "https://schema.org",
  "@type": "Person",
  "@id": "{{ '/' | absolute_url }}#person",
  "name": "Bouke Regnerus",
  "givenName": "Bouke",
  "familyName": "Regnerus",
  "jobTitle": {{ site.data.translations[page.lang].schema_job_title | jsonify }},
  "description": {{ site.data.translations[page.lang].note | jsonify }},
  "url": "{{ page.url | absolute_url }}",
  "email": "bouke@regner.us",
  "telephone": "+31612455817",
  "homeLocation": {
    "@type": "Place",
    "address": {
      "@type": "PostalAddress",
      "addressLocality": "Enschede",
      "addressRegion": "Overijssel",
      "addressCountry": "NL"
    }
  },
  "knowsLanguage": ["nl", "en", "fy"],
  "knowsAbout": ["React Native", "TypeScript", "Mobile App Development", "Smart Home Technology", "Youth Coaching"],
  "hasOccupation": [
    { "@type": "Occupation", "name": "Mobile App Developer" },
    { "@type": "Occupation", "name": {{ site.data.translations[page.lang].coaching_title | jsonify }} }
  ],
  "alumniOf": {
    "@type": "CollegeOrUniversity",
    "name": "University of Twente"
  },
  "worksFor": {
    "@type": "Organization",
    "name": "Athom B.V.",
    "url": "https://homey.app/"
  },
  "affiliation": {
    "@type": "Organization",
    "name": "Stichting Join Us",
    "url": "https://join-us.nu/"
  },
  "sameAs": [
    "https://www.linkedin.com/in/boukeregnerus/",
    "https://github.com/regnerus"
  ],
  "mainEntityOfPage": {
    "@type": "WebPage",
    "@id": "{{ page.url | absolute_url }}"
  }
}
